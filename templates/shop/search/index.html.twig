{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% set searchUrl = path('shop_search', {_locale: app.request.locale}) %}
{% set pageTitle = query != ''
    ? 'shop.search.title_query'|trans({'%query%': query})
    : 'shop.search.title'|trans %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageTitle }}{% endblock %}
{% block meta_description %}{{ 'shop.search.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ pageTitle }}{% endblock %}
{% block og_description %}{{ 'shop.search.meta_description'|trans }}{% endblock %}
{% block og_type %}website{% endblock %}
{% block og_url %}{{ absolute_url(searchUrl) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(searchUrl) }}{% endblock %}

{% block main %}
    <article class="shop-page shop-category-page shop-search-page">
        <nav class="shop-category-page__breadcrumb" aria-label="breadcrumb">
            <a href="{{ path('shop_home', {_locale: app.request.locale}) }}">{{ 'shop.category.home'|trans }}</a>
            <span aria-hidden="true">/</span>
            <span>{{ 'shop.search.breadcrumb'|trans }}</span>
        </nav>

        <header class="shop-category-page__header">
            <h1 class="shop-page__title">
                {% if query != '' %}
                    {{ 'shop.search.heading_query'|trans({'%query%': query}) }}
                {% else %}
                    {{ 'shop.search.heading'|trans }}
                {% endif %}
            </h1>
        </header>

        <form class="shop-search-page__form" action="{{ searchUrl }}" method="get" role="search">
            <label class="visually-hidden" for="shop-search-page-q">{{ 'shop.search.label'|trans }}</label>
            <input
                id="shop-search-page-q"
                class="shop-header-search__input"
                type="search"
                name="q"
                value="{{ query }}"
                placeholder="{{ 'shop.search.placeholder'|trans }}"
                autocomplete="off"
            >
            <button
                class="shop-header-search__button"
                type="submit"
                aria-label="{{ 'shop.search.button'|trans }}"
                title="{{ 'shop.search.button'|trans }}"
            >
                <svg class="shop-header-search__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="M20 20l-3.5-3.5"/>
                </svg>
            </button>
        </form>

        {% include 'shop/partials/_product_listing.html.twig' with {
            products: products,
            total: total,
            page: page,
            pages: pages,
            facets: facets,
            facetLabels: facetLabels|default({}),
            filters: filters,
            activeFilters: activeFilters|default([]),
            query: query,
            showFilters: showFilters,
            filterAction: searchUrl,
            preserveQuery: true,
            emptyMessage: query != ''
                ? 'shop.search.empty'|trans({'%query%': query})
                : 'shop.search.empty_no_query'|trans,
            paginationBasePath: searchUrl,
            paginationQuery: paginationQuery
        } %}
    </article>
{% endblock %}
