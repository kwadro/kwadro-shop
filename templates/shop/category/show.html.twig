{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% set pageTitle = category.metaTitle ?: (setting.seo.title|default(setting.seo.meta_title)) %}
{% set pageMetaTitle = category.metaTitle ?: setting.seo.meta_title %}
{% set pageMetaDescription = category.metaDescription ?: setting.seo.meta_description %}
{% set pageOgTitle = category.ogTitle ?: setting.seo.og_title %}
{% set pageOgDescription = category.ogDescription ?: setting.seo.og_description %}
{% set pageOgType = category.ogType ?: setting.seo.og_type %}
{% if category.ogImage %}
    {% set pageOgImage = absolute_url(category.ogImage|category_og_image) %}
{% elseif setting.seo.og_image %}
    {% set pageOgImage = absolute_url(asset('uploads/images/' ~ setting.seo.og_image)) %}
{% else %}
    {% set pageOgImage = '' %}
{% endif %}
{% set categoryUrl = path('shop_category', {_locale: app.request.locale, slug: category.slug}) %}

{% block body_class %} shop-body--category{% endblock %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageMetaTitle }}{% endblock %}
{% block meta_description %}{{ pageMetaDescription }}{% endblock %}
{% block og_title %}{{ pageOgTitle }}{% endblock %}
{% block og_description %}{{ pageOgDescription }}{% endblock %}
{% block og_type %}{{ pageOgType }}{% endblock %}
{% block og_image %}{{ pageOgImage }}{% endblock %}
{% block og_url %}{{ absolute_url(categoryUrl) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(categoryUrl) }}{% endblock %}

{% block structured_data %}
    {{ product_category_json_ld(category, products|default([]), total|default(0)) }}
{% endblock %}

{% block main %}
    <article class="shop-page shop-category-page">
        <nav class="shop-category-page__breadcrumb" aria-label="breadcrumb">
            {% include 'shop/partials/_breadcrumb_home.html.twig' %}
            {% for parentCategory in breadcrumbAncestors|default([]) %}
                {% if parentCategory and not parentCategory.default %}
                    <span class="shop-category-page__breadcrumb-sep" aria-hidden="true">&gt;</span>
                    <a href="{{ path('shop_category', {_locale: app.request.locale, slug: parentCategory.slug}) }}">{{ parentCategory.name }}</a>
                {% endif %}
            {% endfor %}
            <span class="shop-category-page__breadcrumb-sep" aria-hidden="true">&gt;</span>
            <span>{{ category.name }}</span>
        </nav>

        <header class="shop-category-page__header">
            <h1 class="shop-page__title">{{ category.name }}</h1>
        </header>

        {% set subcategoryNavItems = siblings is not empty ? siblings : [] %}
        {% set showSubcategoryNav = subcategoryNavItems|length > 2 %}
        {% set subcategoryNavParentName = subcategoryNavParentName|default(category.name) %}
        {% if showSubcategoryNav %}
            <section class="shop-category-page__children shop-category-page__children--desktop" aria-label="{{ 'shop.category.subcategories_of'|trans({ '%name%': subcategoryNavParentName }) }}">
                {% for item in subcategoryNavItems %}
                    {% set isActive = activeSiblingId is not null and item.id == activeSiblingId %}
                    <a
                        class="shop-category-page__child-chip{{ isActive ? ' is-active' : '' }}"
                        href="{{ path('shop_category', {_locale: app.request.locale, slug: item.slug}) }}"
                        {% if isActive %}aria-current="page"{% endif %}
                    >
                        {{ item.name }}
                    </a>
                {% endfor %}
            </section>
        {% endif %}

        {% if children is not empty %}
            <section class="shop-category-page__children shop-category-page__children--desktop " aria-label="{{ 'shop.category.subcategories'|trans }}">
                {% for child in children %}
                    <a
                        class="shop-category-page__child-chip"
                        href="{{ path('shop_category', {_locale: app.request.locale, slug: child.slug}) }}"
                    >
                        {{ child.name }}
                    </a>
                {% endfor %}
            </section>
        {% endif %}
        {% include 'shop/partials/_product_listing.html.twig' with {
            products: products,
            total: total,
            page: page,
            pages: pages,
            facets: facets,
            facetLabels: facetLabels|default({}),
            filters: filters,
            activeFilters: activeFilters|default([]),
            query: query,
            showFilters: showFilters,
            sort: sort|default('rank'),
            priceMin: priceMin|default(null),
            priceMax: priceMax|default(null),
            priceBounds: priceBounds|default(null),
            filterAction: categoryUrl,
            preserveQuery: false,
            emptyMessage: 'shop.category.empty_products'|trans,
            paginationBasePath: categoryUrl,
            paginationQuery: paginationQuery,
            subcategoryNavItems: showSubcategoryNav ? subcategoryNavItems : [],
            activeSiblingId: activeSiblingId|default(null),
            subcategoryNavParentName: subcategoryNavParentName
        } %}
    </article>
{% endblock %}
