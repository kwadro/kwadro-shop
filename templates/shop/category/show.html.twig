{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% set pageTitle = category.metaTitle ?: (setting.seo.title|default(setting.seo.meta_title)) %}
{% set pageMetaTitle = category.metaTitle ?: setting.seo.meta_title %}
{% set pageMetaDescription = category.metaDescription ?: setting.seo.meta_description %}
{% set pageOgTitle = category.ogTitle ?: setting.seo.og_title %}
{% set pageOgDescription = category.ogDescription ?: setting.seo.og_description %}
{% set pageOgType = category.ogType ?: setting.seo.og_type %}
{% set pageOgImageFile = category.ogImage ?: setting.seo.og_image %}
{% set pageOgImage = pageOgImageFile ? absolute_url(asset('uploads/images/' ~ pageOgImageFile)) : '' %}
{% set categoryUrl = path('shop_category', {_locale: app.request.locale, slug: category.slug}) %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageMetaTitle }}{% endblock %}
{% block meta_description %}{{ pageMetaDescription }}{% endblock %}
{% block og_title %}{{ pageOgTitle }}{% endblock %}
{% block og_description %}{{ pageOgDescription }}{% endblock %}
{% block og_type %}{{ pageOgType }}{% endblock %}
{% block og_image %}{{ pageOgImage }}{% endblock %}
{% block og_url %}{{ absolute_url(categoryUrl) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(categoryUrl) }}{% endblock %}

{% block main %}
    <article class="shop-page shop-category-page">
        <nav class="shop-category-page__breadcrumb" aria-label="breadcrumb">
            <a href="{{ path('shop_home', {_locale: app.request.locale}) }}">{{ 'shop.category.home'|trans }}</a>
            {% set parentCategory = category.parent %}
            {% if parentCategory and not parentCategory.default %}
                <span aria-hidden="true">/</span>
                <a href="{{ path('shop_category', {_locale: app.request.locale, slug: parentCategory.slug}) }}">{{ parentCategory.name }}</a>
            {% endif %}
            <span aria-hidden="true">/</span>
            <span>{{ category.name }}</span>
        </nav>

        <header class="shop-category-page__header">
            <h1 class="shop-page__title">{{ category.name }}</h1>
        </header>

        {% if children is not empty %}
            <section class="shop-category-page__children" aria-label="{{ 'shop.category.subcategories'|trans }}">
                {% for child in children %}
                    <a
                        class="shop-category-page__child-chip"
                        href="{{ path('shop_category', {_locale: app.request.locale, slug: child.slug}) }}"
                    >
                        {{ child.name }}
                    </a>
                {% endfor %}
            </section>
        {% endif %}

        {% include 'shop/partials/_product_listing.html.twig' with {
            products: products,
            total: total,
            page: page,
            pages: pages,
            facets: facets,
            filters: filters,
            query: query,
            showFilters: showFilters,
            filterAction: categoryUrl,
            preserveQuery: false,
            emptyMessage: 'shop.category.empty_products'|trans,
            paginationBasePath: categoryUrl,
            paginationQuery: paginationQuery
        } %}
    </article>
{% endblock %}
