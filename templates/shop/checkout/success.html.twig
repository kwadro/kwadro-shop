{% extends 'shop/layout.html.twig' %}

{% set block_search_engines = true %}

{% block title %}{{ 'shop.checkout.success_title'|trans }}{% endblock %}

{% block main %}
    <article class="shop-page shop-checkout">
        <h1 class="shop-page__title">{{ 'shop.checkout.success_title'|trans }}</h1>

        {% if order %}
            {% set variant = order.success_variant|default('paid') %}
            <div class="shop-checkout__alert shop-checkout__success{% if variant == 'payment_failed' %} shop-checkout__alert--error{% elseif variant == 'payment_pending' %} shop-checkout__alert--warning{% else %} shop-checkout__alert--success{% endif %}">
                {% if variant == 'awaiting_deposit' %}
                    <p>{{ 'shop.checkout.success_deposit_main'|trans({'%order_id%': order.id}) }}</p>
                    <p>{{ 'shop.checkout.success_deposit_payment'|trans }}</p>
                    <p>{{ 'shop.checkout.success_deposit_waybill'|trans }}</p>
                {% elseif variant == 'payment_pending' %}
                    <p>{{ 'shop.checkout.success_pending_main'|trans({'%order_id%': order.id}) }}</p>
                    <p>{{ 'shop.checkout.success_pending_hint'|trans }}</p>
                {% elseif variant == 'payment_failed' %}
                    <p>{{ 'shop.checkout.success_failed_main'|trans({'%order_id%': order.id}) }}</p>
                    <p>{{ 'shop.checkout.success_failed_hint'|trans }}</p>
                {% else %}
                    <p>{{ 'shop.checkout.success_paid_main'|trans({'%order_id%': order.id}) }}</p>
                    {% if not order.do_not_call %}
                        <p>{{ 'shop.checkout.success_paid_call'|trans }}</p>
                    {% endif %}
                    <p>{{ 'shop.checkout.success_paid_waybill'|trans }}</p>
                {% endif %}
            </div>
        {% else %}
            <p>{{ 'shop.checkout.success_no_order'|trans }}</p>
        {% endif %}

        <a href="{{ path('shop_home', {_locale: app.request.locale}) }}" class="shop-checkout__back">
            ← {{ 'shop.checkout.back_to_shop'|trans }}
        </a>
    </article>
{% endblock %}

{% block javascripts %}
    {% if order %}
        {% set pixel_id = site_settings().tracking.meta_pixel_id|default('') %}
        {% set productIds = order.product_ids|default([]) %}
        {% if pixel_id matches '/^[0-9]{5,20}$/' %}
            <script>
                (function () {
                    var key = 'fbq-purchase-' + {{ order.id|default('')|json_encode|raw }};
                    try {
                        if (window.sessionStorage.getItem(key)) {
                            return;
                        }
                        window.sessionStorage.setItem(key, '1');
                    } catch (e) {}

                    if (typeof fbq !== 'function') {
                        return;
                    }

                    fbq('track', 'Purchase', {
                        content_ids: {{ productIds|json_encode|raw }},
                        content_type: 'product',
                        value: {{ order.total|default(0) }},
                        currency: 'UAH'
                    });
                })();
            </script>
        {% endif %}
    {% endif %}
{% endblock %}
