{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}

{% set productPlainDescription = product.shortDescription|default('')|striptags|trim %}
{% if productPlainDescription is empty %}
    {% set productPlainDescription = product.description|default('')|striptags|trim %}
{% endif %}

{% set pageTitle = product.title ?: product.name %}
{% set pageMetaTitle = product.metaTitle ?: product.name %}
{% set pageMetaDescription = product.metaDescription ?: (productPlainDescription ?: setting.seo.meta_description) %}
{% set pageOgTitle = product.ogTitle ?: product.name %}
{% set pageOgDescription = product.ogDescription ?: pageMetaDescription %}
{% set pageOgType = product.ogType ?: 'product' %}

{% set galleryImage = product.gallery[0].full|default('')|product_image %}
{% if product.ogImage %}
    {% set pageOgImage = absolute_url(asset('uploads/images/' ~ product.ogImage)) %}
{% elseif galleryImage %}
    {% set pageOgImage = galleryImage starts with 'http' ? galleryImage : absolute_url(galleryImage) %}
{% elseif setting.seo.og_image %}
    {% set pageOgImage = absolute_url(asset('uploads/images/' ~ setting.seo.og_image)) %}
{% else %}
    {% set pageOgImage = '' %}
{% endif %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageMetaTitle }}{% endblock %}
{% block meta_description %}{{ pageMetaDescription }}{% endblock %}
{% block og_title %}{{ pageOgTitle }}{% endblock %}
{% block og_description %}{{ pageOgDescription }}{% endblock %}
{% block og_type %}{{ pageOgType }}{% endblock %}
{% block og_image %}{{ pageOgImage }}{% endblock %}
{% block og_url %}{{ absolute_url(path('shop_product', {_locale: app.request.locale, slug: product.slug})) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(path('shop_product', {_locale: app.request.locale, slug: product.slug})) }}{% endblock %}

{% block main %}
    {% include 'shop/partials/_product_view.html.twig' %}
{% endblock %}

{% block javascripts %}
    {% include 'shop/partials/_product_view_scripts.html.twig' %}
{% endblock %}
