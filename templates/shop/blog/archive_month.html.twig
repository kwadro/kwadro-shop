{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% set heading = monthLabel ~ ' ' ~ year %}
{% set pageTitle = heading ~ ' — ' ~ ('shop.blog.title'|trans) %}
{% set pageDescription = 'shop.blog.archive_month_description'|trans({ '%month%': heading }) %}
{% set pageOgImage = absolute_url(asset('uploads/og-images/og-blog-archive.jpg')) %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageTitle }}{% endblock %}
{% block meta_description %}{{ pageDescription }}{% endblock %}
{% block og_title %}{{ pageTitle }}{% endblock %}
{% block og_description %}{{ pageDescription }}{% endblock %}
{% block og_type %}website{% endblock %}
{% block og_image %}{{ pageOgImage }}{% endblock %}
{% block og_url %}{{ absolute_url(path('shop_blog_archive_month', {_locale: app.request.locale, year: year, month: '%02d'|format(month)})) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(path('shop_blog_archive_month', {_locale: app.request.locale, year: year, month: '%02d'|format(month)})) }}{% endblock %}

{% block main %}
    <div class="shop-page shop-blog-page">
        <nav class="shop-category-page__breadcrumb" aria-label="breadcrumb">
            <a href="{{ path('shop_home', {_locale: app.request.locale}) }}">{{ 'shop.category.home'|trans }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ path('shop_blog_index', {_locale: app.request.locale}) }}">{{ 'shop.blog.title'|trans }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ path('shop_blog_archive', {_locale: app.request.locale}) }}">{{ 'shop.blog.archive'|trans }}</a>
            <span aria-hidden="true">/</span>
            <span>{{ heading }}</span>
        </nav>

        <header class="shop-category-page__header">
            <h1 class="shop-page__title">{{ heading }}</h1>
        </header>

        {% include 'shop/blog/_search.html.twig' with {searchQuery: ''} %}

        <div class="shop-blog-layout">
            <div class="shop-blog-layout__main">
                {% if articles is empty %}
                    <div class="shop-blog-page__empty">
                        <p>{{ 'shop.blog.archive_month_empty'|trans }}</p>
                    </div>
                {% else %}
                    <div class="shop-blog-list">
                        {% for article in articles %}
                            {% include 'shop/blog/_article_card.html.twig' with {article: article} %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            {% include 'shop/blog/_sidebar.html.twig' %}
        </div>
    </div>
{% endblock %}
