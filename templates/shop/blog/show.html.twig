{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% set pageTitle = article.metaTitle ?: (article.title ~ ' — ' ~ (setting.seo.title|default(setting.seo.meta_title))) %}
{% set pageDescription = article.metaDescription ?: setting.seo.meta_description %}
{% set pageOgTitle = article.ogTitle ?: pageTitle %}
{% set pageOgDescription = article.ogDescription ?: pageDescription %}
{% set pageOgType = article.ogType ?: 'article' %}
{% set pageOgImageFile = article.ogImage ?: setting.seo.og_image %}
{% set pageOgImage = pageOgImageFile ? absolute_url(asset('uploads/images/' ~ pageOgImageFile)) : '' %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageTitle }}{% endblock %}
{% block meta_description %}{{ pageDescription }}{% endblock %}
{% block og_title %}{{ pageOgTitle }}{% endblock %}
{% block og_description %}{{ pageOgDescription }}{% endblock %}
{% block og_type %}{{ pageOgType }}{% endblock %}
{% block og_image %}{{ pageOgImage }}{% endblock %}
{% block og_url %}{{ absolute_url(path('shop_blog_article', {_locale: app.request.locale, slug: article.slug})) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(path('shop_blog_article', {_locale: app.request.locale, slug: article.slug})) }}{% endblock %}

{% block main %}
    <article class="shop-page shop-blog-article">
        <nav class="shop-category-page__breadcrumb" aria-label="breadcrumb">
            <a href="{{ path('shop_home', {_locale: app.request.locale}) }}">{{ 'shop.category.home'|trans }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ path('shop_blog_index', {_locale: app.request.locale}) }}">{{ 'shop.blog.title'|trans }}</a>
            <span aria-hidden="true">/</span>
            <span>{{ article.title }}</span>
        </nav>

        <header class="shop-blog-article__header">
            <h1 class="shop-page__title">{{ article.title }}</h1>
            {% if article.publishedAt %}
                <time class="shop-blog-article__date" datetime="{{ article.publishedAt|date('c') }}">
                    {{ article.publishedAt|date('d.m.Y') }}
                </time>
            {% endif %}
            {% if article.categories is not empty %}
                <ul class="shop-blog-card__categories">
                    {% for category in article.categories %}
                        {% if category.enabled %}
                            <li>{{ category.name }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            {% endif %}
        </header>

        <div class="shop-page__content shop-blog-article__content">
            {{ article.content|raw }}
        </div>
    </article>
{% endblock %}
