{% set facetLabels = {
    category: 'shop.filter.category'|trans,
    brand: 'shop.filter.brand'|trans,
    color: 'shop.filter.color'|trans,
    type: 'shop.filter.type'|trans,
    model: 'shop.filter.model'|trans,
    price: 'shop.filter.price'|trans
}|merge(facetLabels|default({})) %}

{% set sort = sort|default('rank') %}
{% set priceBounds = priceBounds|default(null) %}
{% set hasPriceFilter = priceBounds is not null and priceBounds.max > priceBounds.min %}
{% set selectedPriceMin = priceMin is not null ? priceMin : (hasPriceFilter ? priceBounds.min : null) %}
{% set selectedPriceMax = priceMax is not null ? priceMax : (hasPriceFilter ? priceBounds.max : null) %}

{# A facet group is rendered only when it offers a real choice (2+ options). #}
{% set visibleFacetGroups = facets|default({})|filter(options => options|length > 1) %}
{% set showFilters = showFilters|default(false)
    and (visibleFacetGroups is not empty or activeFilters|default([]) is not empty or hasPriceFilter) %}

{% set clearAllHref = filterAction %}
{% if preserveQuery|default(false) and query|default('') != '' %}
    {% set clearAllHref = filterAction ~ '?q=' ~ query|url_encode %}
{% endif %}

{% set sortFormParams = paginationQuery|default({})|filter((v, k) => k not in ['sort', 'dir']) %}

{% macro filter_chips(activeFilters, facetLabels, filterAction, clearAllHref) %}
    {% if activeFilters is not empty %}
        <div class="shop-filters__selected" aria-label="{{ 'shop.filter.selected'|trans }}">
            <div class="shop-filters__chips">
                {% for item in activeFilters %}
                    {% set chipHref = filterAction ~ (item.query is not empty ? '?' ~ item.query|url_encode : '') %}
                    <a
                        class="shop-filters__chip"
                        href="{{ chipHref }}"
                        title="{{ 'shop.filter.remove'|trans }}"
                    >
                        <span class="shop-filters__chip-label">{{ facetLabels[item.attr]|default(item.attr) }}: {{ item.value }}</span>
                        <span class="shop-filters__chip-remove" aria-hidden="true">×</span>
                        <span class="visually-hidden">{{ 'shop.filter.remove'|trans }}</span>
                    </a>
                {% endfor %}
            </div>
            {% if activeFilters|length > 1 %}
                <a class="shop-filters__clear-all" href="{{ clearAllHref }}">
                    {{ 'shop.filter.clear_all'|trans }}
                </a>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}
{% import _self as listing %}

{% set subcategoryNavItems = subcategoryNavItems|default([]) %}
{% set hasSubcategoryNav = subcategoryNavItems is not empty %}

<div class="shop-catalog{% if showFilters|default(false) %} shop-catalog--with-filters{% endif %}">
    {% if showFilters|default(false) or hasSubcategoryNav %}
        <div class="shop-catalog__mobile-bar">
            <div class="shop-catalog__mobile-actions">
                {% if hasSubcategoryNav %}
                    <button
                        type="button"
                        class="shop-sheet-trigger"
                        data-sheet-open="shop-category-sheet"
                        aria-expanded="false"
                        aria-controls="shop-category-sheet"
                    >
                        {{ 'shop.category.subcategories'|trans }}
                    </button>
                {% endif %}
                {% if showFilters|default(false) %}
                    <button
                        type="button"
                        class="shop-sheet-trigger"
                        data-sheet-open="shop-filters-sheet"
                        aria-expanded="false"
                        aria-controls="shop-filters-sheet"
                    >
                        {{ 'shop.filter.title'|trans }}
                        {% if activeFilters|default([]) is not empty %}
                            <span class="shop-sheet-trigger__badge">{{ activeFilters|length }}</span>
                        {% endif %}
                    </button>
                {% endif %}
            </div>

            {% if showFilters|default(false) and activeFilters|default([]) is not empty %}
                <div class="shop-catalog__mobile-chips">
                    {{ listing.filter_chips(activeFilters, facetLabels, filterAction, clearAllHref) }}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if hasSubcategoryNav %}
        <div
            id="shop-category-sheet"
            class="shop-sheet shop-sheet--popover shop-category-page__sheet"
            data-sheet
        >
            <div class="shop-sheet__overlay" data-sheet-close></div>
            <div
                class="shop-sheet__dialog"
                role="dialog"
                aria-modal="true"
                aria-labelledby="shop-category-sheet-title"
            >
                <div class="shop-sheet__header">
                    <h2 id="shop-category-sheet-title" class="shop-sheet__title">
                        {% if subcategoryNavParentName|default('') != '' %}
                            {{ 'shop.category.subcategories_of'|trans({ '%name%': subcategoryNavParentName }) }}
                        {% else %}
                            {{ 'shop.category.subcategories'|trans }}
                        {% endif %}
                    </h2>
                    <button
                        type="button"
                        class="shop-sheet__close"
                        data-sheet-close
                        aria-label="{{ 'shop.category.close_subcategories'|trans }}"
                    >×</button>
                </div>
                <div class="shop-sheet__body">
                    <section class="shop-category-page__children" aria-label="{{ subcategoryNavParentName|default('') != '' ? 'shop.category.subcategories_of'|trans({ '%name%': subcategoryNavParentName }) : 'shop.category.subcategories'|trans }}">
                        {% for item in subcategoryNavItems %}
                            {% set isActive = activeSiblingId is defined and activeSiblingId is not null and item.id == activeSiblingId %}
                            <a
                                class="shop-category-page__child-chip{{ isActive ? ' is-active' : '' }}"
                                href="{{ path('shop_category', {_locale: app.request.locale, slug: item.slug}) }}"
                                data-sheet-autoclose
                                {% if isActive %}aria-current="page"{% endif %}
                            >
                                {{ item.name }}
                            </a>
                        {% endfor %}
                    </section>
                </div>
            </div>
        </div>
    {% endif %}

    {% if showFilters|default(false) %}
        <aside
            id="shop-filters-sheet"
            class="shop-catalog__filters shop-sheet shop-sheet--popover"
            data-sheet
            aria-label="{{ 'shop.filter.title'|trans }}"
        >
            <div class="shop-sheet__overlay" data-sheet-close></div>
            <div
                class="shop-sheet__dialog"
                role="dialog"
                aria-modal="true"
                aria-labelledby="shop-filters-sheet-title"
            >
                <div class="shop-sheet__header shop-filters__sheet-header">
                    <h2 id="shop-filters-sheet-title" class="shop-sheet__title">{{ 'shop.filter.title'|trans }}</h2>
                    <button
                        type="button"
                        class="shop-sheet__close"
                        data-sheet-close
                        aria-label="{{ 'shop.filter.close'|trans }}"
                    >×</button>
                </div>

                <form class="shop-filters shop-sheet__body" method="get" action="{{ filterAction }}" data-shop-filters>
                {% if preserveQuery|default(false) and query|default('') != '' %}
                    <input type="hidden" name="q" value="{{ query }}">
                {% endif %}
                {% if sort != 'rank' %}
                    <input type="hidden" name="sort" value="{{ sort }}">
                {% endif %}

                <div class="shop-filters__body" id="shop-filters-panel-body" data-filter-panel-body>
                    <div class="shop-filters__selected--desktop">
                        {{ listing.filter_chips(activeFilters|default([]), facetLabels, filterAction, clearAllHref) }}
                    </div>

                    {% if hasPriceFilter %}
                        {% set priceGroupHasSelection = (priceMin is not null) or (priceMax is not null) %}
                        <fieldset
                            class="shop-filters__group shop-filters__group--price"
                            data-filter-group
                            data-price-range
                            data-price-bound-min="{{ priceBounds.min }}"
                            data-price-bound-max="{{ priceBounds.max }}"
                            {% if priceGroupHasSelection %}data-has-selection{% endif %}
                        >
                            <legend class="shop-filters__legend">
                                <button
                                    type="button"
                                    class="shop-filters__group-toggle"
                                    data-filter-group-toggle
                                    aria-expanded="true"
                                    aria-controls="shop-filter-group-price"
                                >
                                    <span>{{ 'shop.filter.price'|trans }}</span>
                                    <span class="shop-filters__chevron" aria-hidden="true"></span>
                                </button>
                            </legend>
                            <div
                                class="shop-filters__options shop-filters__price"
                                id="shop-filter-group-price"
                                data-filter-group-body
                            >
                                <div class="shop-filters__price-values" aria-live="polite">
                                    <span data-price-label-min>{{ selectedPriceMin|number_format(0, ',', ' ') }}</span>
                                    <span aria-hidden="true">–</span>
                                    <span data-price-label-max>{{ selectedPriceMax|number_format(0, ',', ' ') }}</span>
                                    <span aria-hidden="true">₴</span>
                                </div>
                                <div class="shop-filters__price-slider">
                                    <div class="shop-filters__price-track" aria-hidden="true">
                                        <div class="shop-filters__price-range" data-price-range-fill></div>
                                    </div>
                                    <input
                                        type="range"
                                        class="shop-filters__price-thumb"
                                        name="price_min"
                                        min="{{ priceBounds.min }}"
                                        max="{{ priceBounds.max }}"
                                        step="1"
                                        value="{{ selectedPriceMin }}"
                                        aria-label="{{ 'shop.filter.price_min'|trans }}"
                                        data-price-min
                                    >
                                    <input
                                        type="range"
                                        class="shop-filters__price-thumb"
                                        name="price_max"
                                        min="{{ priceBounds.min }}"
                                        max="{{ priceBounds.max }}"
                                        step="1"
                                        value="{{ selectedPriceMax }}"
                                        aria-label="{{ 'shop.filter.price_max'|trans }}"
                                        data-price-max
                                    >
                                </div>
                            </div>
                        </fieldset>
                    {% endif %}

                    {% for attr, options in facets|default({}) %}
                        {% if options|length > 1 %}
                            {% set visibleLimit = 5 %}
                            {% set hasMore = options|length > visibleLimit %}
                            {% set extraOptions = hasMore ? options|slice(visibleLimit) : [] %}
                            {% set selectedValues = filters[attr]|default([]) %}
                            {% set extraValues = extraOptions|map(o => o.value) %}
                            {% set hiddenChecked = selectedValues|filter(v => v in extraValues)|length > 0 %}
                            {% set groupId = 'shop-filter-group-' ~ attr %}
                            {% set groupHasSelection = selectedValues|length > 0 %}
                            <fieldset class="shop-filters__group" data-filter-group{% if groupHasSelection %} data-has-selection{% endif %}>
                                <legend class="shop-filters__legend">
                                    <button
                                        type="button"
                                        class="shop-filters__group-toggle"
                                        data-filter-group-toggle
                                        aria-expanded="true"
                                        aria-controls="{{ groupId }}"
                                    >
                                        <span>{{ facetLabels[attr]|default(attr) }}</span>
                                        <span class="shop-filters__chevron" aria-hidden="true"></span>
                                    </button>
                                </legend>
                                <div
                                    class="shop-filters__options"
                                    id="{{ groupId }}"
                                    data-filter-group-body
                                >
                                    {% for option in options|slice(0, visibleLimit) %}
                                        {% set checked = option.value in selectedValues %}
                                        <label class="shop-filters__option">
                                            <input
                                                type="checkbox"
                                                name="{{ attr }}[]"
                                                value="{{ option.value }}"
                                                {% if checked %}checked{% endif %}
                                                data-filter-auto-submit
                                            >
                                            <span class="shop-filters__option-label">{{ option.value }}</span>
                                            <span class="shop-filters__option-count">({{ option.count }})</span>
                                        </label>
                                    {% endfor %}

                                    {% if hasMore %}
                                        <div
                                            class="shop-filters__options-extra"
                                            {% if not hiddenChecked %}hidden{% endif %}
                                            data-filter-extra
                                        >
                                            {% for option in extraOptions %}
                                                {% set checked = option.value in selectedValues %}
                                                <label class="shop-filters__option">
                                                    <input
                                                        type="checkbox"
                                                        name="{{ attr }}[]"
                                                        value="{{ option.value }}"
                                                        {% if checked %}checked{% endif %}
                                                        data-filter-auto-submit
                                                    >
                                                    <span class="shop-filters__option-label">{{ option.value }}</span>
                                                    <span class="shop-filters__option-count">({{ option.count }})</span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                        <button
                                            type="button"
                                            class="shop-filters__show-all"
                                            data-filter-toggle
                                            data-label-more="{{ 'shop.filter.show_all'|trans({'%count%': extraOptions|length}) }}"
                                            data-label-less="{{ 'shop.filter.show_less'|trans }}"
                                            aria-expanded="{{ hiddenChecked ? 'true' : 'false' }}"
                                        >
                                            {{ hiddenChecked
                                                ? 'shop.filter.show_less'|trans
                                                : 'shop.filter.show_all'|trans({'%count%': extraOptions|length})
                                            }}
                                        </button>
                                    {% endif %}
                                </div>
                            </fieldset>
                        {% endif %}
                    {% endfor %}

                    <noscript>
                        <button class="shop-filters__submit" type="submit">{{ 'shop.filter.apply'|trans }}</button>
                    </noscript>
                </div>
                </form>
            </div>
        </aside>
    {% endif %}

    <div class="shop-catalog__main">
        {% if products is empty %}
            <div class="shop-category-page__empty">
                <p>{{ emptyMessage }}</p>
            </div>
        {% else %}
            <div class="shop-catalog__toolbar">
                {% if total is defined %}
                    <p class="shop-catalog__count">{{ 'shop.catalog.results_count'|trans({'%count%': total}) }}</p>
                {% endif %}

                {% set sortOptions = {
                    rank: 'shop.sort.rank'|trans,
                    cheap: 'shop.sort.cheap'|trans,
                    expensive: 'shop.sort.expensive'|trans,
                    novelty: 'shop.sort.novelty'|trans
                } %}
                <form class="shop-catalog__sort" method="get" action="{{ filterAction }}" data-shop-sort>
                    {% for key, value in sortFormParams %}
                        {% if value is iterable %}
                            {% for item in value %}
                                <input type="hidden" name="{{ key }}[]" value="{{ item }}">
                            {% endfor %}
                        {% else %}
                            <input type="hidden" name="{{ key }}" value="{{ value }}">
                        {% endif %}
                    {% endfor %}

                    <div class="shop-catalog__sort-field" data-sort-dropdown>
                        <span class="shop-catalog__sort-label" id="shop-sort-label">{{ 'shop.sort.by'|trans }}</span>
                        <button
                            type="button"
                            class="shop-catalog__sort-trigger"
                            data-sort-trigger
                            aria-expanded="false"
                            aria-haspopup="listbox"
                            aria-controls="shop-sort-menu"
                            aria-labelledby="shop-sort-label shop-sort-value"
                        >
                            <span id="shop-sort-value" data-sort-value-label>{{ sortOptions[sort]|default(sortOptions.rank) }}</span>
                            <span class="shop-catalog__sort-caret" aria-hidden="true"></span>
                        </button>

                        <div
                            id="shop-sort-menu"
                            class="shop-catalog__sort-menu"
                            data-sort-menu
                            role="listbox"
                            aria-labelledby="shop-sort-label"
                            hidden
                        >
                            {% for value, label in sortOptions %}
                                <button
                                    type="submit"
                                    class="shop-catalog__sort-option{% if sort == value %} is-active{% endif %}"
                                    name="sort"
                                    value="{{ value }}"
                                    role="option"
                                    aria-selected="{{ sort == value ? 'true' : 'false' }}"
                                >
                                    {{ label }}
                                </button>
                            {% endfor %}
                        </div>
                    </div>

                    <noscript>
                        <label class="shop-catalog__sort-field">
                            <span class="shop-catalog__sort-label">{{ 'shop.sort.by'|trans }}</span>
                            <select name="sort" onchange="this.form.submit()" aria-label="{{ 'shop.sort.by'|trans }}">
                                {% for value, label in sortOptions %}
                                    <option value="{{ value }}"{% if sort == value %} selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </noscript>
                </form>
            </div>

            {% set useInfiniteScroll = infiniteScroll|default(false) and pages|default(1) > 1 %}
            {% if useInfiniteScroll %}
                <div
                    class="shop-infinite-scroll"
                    data-infinite-scroll
                    data-page="{{ page }}"
                    data-pages="{{ pages }}"
                    data-url="{{ paginationBasePath }}"
                    data-query="{{ paginationQuery|default({})|json_encode|e('html_attr') }}"
                    data-loading-label="{{ 'shop.catalog.loading_more'|trans|e('html_attr') }}"
                    data-error-label="{{ 'shop.catalog.load_more_error'|trans|e('html_attr') }}"
                >
                    <div class="shop-catalog-grid" data-infinite-scroll-grid>
                        {% include 'shop/partials/_product_cards.html.twig' with {products: products} only %}
                    </div>

                    <div
                        class="shop-infinite-scroll__sentinel"
                        data-infinite-scroll-sentinel
                        aria-hidden="true"
                    ></div>
                    <p
                        class="shop-infinite-scroll__status"
                        data-infinite-scroll-status
                        aria-live="polite"
                    ></p>
                    <noscript>
                        {% include 'shop/partials/_pagination.html.twig' with {
                            page: page,
                            pages: pages,
                            paginationBasePath: paginationBasePath,
                            paginationQuery: paginationQuery|default({})
                        } only %}
                    </noscript>
                </div>
            {% else %}
                <div class="shop-catalog-grid">
                    {% include 'shop/partials/_product_cards.html.twig' with {products: products} only %}
                </div>

                {% if pages|default(1) > 1 %}
                    {% include 'shop/partials/_pagination.html.twig' with {
                        page: page,
                        pages: pages,
                        paginationBasePath: paginationBasePath,
                        paginationQuery: paginationQuery|default({})
                    } only %}
                {% endif %}
            {% endif %}
        {% endif %}
    </div>
</div>

<script>
(() => {
    const mobileMq = window.matchMedia('(max-width: 900px)');
    const scrollAfterFilterKey = 'shopScrollToCategoryHeader';

    document.querySelectorAll('[data-sort-dropdown]').forEach((dropdown) => {
        const trigger = dropdown.querySelector('[data-sort-trigger]');
        const menu = dropdown.querySelector('[data-sort-menu]');
        if (!trigger || !menu) {
            return;
        }

        const setOpen = (open) => {
            trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
            menu.hidden = !open;
        };

        trigger.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            setOpen(menu.hidden);
        });

        menu.querySelectorAll('.shop-catalog__sort-option').forEach((option) => {
            option.addEventListener('click', () => {
                setOpen(false);
            });
        });

        document.addEventListener('click', (event) => {
            if (!dropdown.contains(event.target)) {
                setOpen(false);
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') {
                setOpen(false);
            }
        });
    });

    const markScrollToCategoryHeader = () => {
        if (!mobileMq.matches) {
            return;
        }
        try {
            sessionStorage.setItem(scrollAfterFilterKey, '1');
        } catch (e) {
            // Ignore storage failures (private mode, etc.).
        }
    };

    const closeFilterSheet = (form) => {
        const sheet = form?.closest('[data-sheet]');
        if (sheet && window.ShopSheet) {
            window.ShopSheet.close(sheet);
        }
    };

    const submitFilterForm = (form) => {
        if (!form) {
            return;
        }
        markScrollToCategoryHeader();
        closeFilterSheet(form);
        form.submit();
    };

    const scrollToCategoryHeaderIfNeeded = () => {
        if (!mobileMq.matches) {
            return;
        }
        let shouldScroll = false;
        try {
            shouldScroll = sessionStorage.getItem(scrollAfterFilterKey) === '1';
            if (shouldScroll) {
                sessionStorage.removeItem(scrollAfterFilterKey);
            }
        } catch (e) {
            return;
        }
        if (!shouldScroll) {
            return;
        }
        const header = document.querySelector('.shop-category-page__header');
        if (!header) {
            return;
        }
        requestAnimationFrame(() => {
            header.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    };

    const setExpanded = (button, body, expanded, group) => {
        button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        if (body) {
            body.hidden = !expanded;
        }
        if (group) {
            group.classList.toggle('is-collapsed', !expanded);
        }
    };

    const applyViewportState = () => {
        const isMobile = mobileMq.matches;

        document.querySelectorAll('[data-filter-group-toggle]').forEach((button) => {
            const group = button.closest('[data-filter-group]');
            const body = group?.querySelector('[data-filter-group-body]');
            if (!isMobile) {
                setExpanded(button, body, true, group);
                return;
            }
            if (group?.dataset.userToggled === '1') {
                return;
            }
            setExpanded(button, body, group?.hasAttribute('data-has-selection') ?? false, group);
        });
    };

    document.querySelectorAll('[data-filter-group-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
            if (!mobileMq.matches) {
                return;
            }
            const group = button.closest('[data-filter-group]');
            const body = group?.querySelector('[data-filter-group-body]');
            const expanded = button.getAttribute('aria-expanded') === 'true';
            if (group) {
                group.dataset.userToggled = '1';
            }
            setExpanded(button, body, !expanded, group);
        });
    });

    document.querySelectorAll('[data-filter-toggle]').forEach((button) => {
        button.addEventListener('click', () => {
            const extra = button.parentElement?.querySelector('[data-filter-extra]');
            if (!extra) {
                return;
            }
            const expanded = button.getAttribute('aria-expanded') === 'true';
            extra.hidden = expanded;
            button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
            button.textContent = expanded
                ? button.dataset.labelMore
                : button.dataset.labelLess;
        });
    });

    const formatPrice = (value) => Number(value).toLocaleString('uk-UA', {
        maximumFractionDigits: 0,
    });

    document.querySelectorAll('[data-price-range]').forEach((group) => {
        const form = group.closest('form');
        const minRange = group.querySelector('[data-price-min]');
        const maxRange = group.querySelector('[data-price-max]');
        const minLabel = group.querySelector('[data-price-label-min]');
        const maxLabel = group.querySelector('[data-price-label-max]');
        const fill = group.querySelector('[data-price-range-fill]');
        const boundMin = Number(group.dataset.priceBoundMin);
        const boundMax = Number(group.dataset.priceBoundMax);
        if (!form || !minRange || !maxRange || !(boundMax > boundMin)) {
            return;
        }

        let submitTimer = null;

        const syncFill = (min, max) => {
            if (!fill) {
                return;
            }
            const span = boundMax - boundMin;
            const left = ((min - boundMin) / span) * 100;
            const right = ((max - boundMin) / span) * 100;
            fill.style.left = `${left}%`;
            fill.style.width = `${Math.max(0, right - left)}%`;
        };

        const applyValues = (min, max, { submit = false } = {}) => {
            let nextMin = Math.min(Math.max(min, boundMin), boundMax);
            let nextMax = Math.min(Math.max(max, boundMin), boundMax);
            if (nextMin > nextMax) {
                nextMin = nextMax;
            }
            minRange.value = String(nextMin);
            maxRange.value = String(nextMax);
            if (minLabel) {
                minLabel.textContent = formatPrice(nextMin);
            }
            if (maxLabel) {
                maxLabel.textContent = formatPrice(nextMax);
            }
            syncFill(nextMin, nextMax);

            if (!submit) {
                return;
            }
            window.clearTimeout(submitTimer);
            submitTimer = window.setTimeout(() => submitFilterForm(form), 350);
        };

        applyValues(Number(minRange.value), Number(maxRange.value));

        minRange.addEventListener('input', () => {
            minRange.style.zIndex = '3';
            maxRange.style.zIndex = '2';
            const min = Number(minRange.value);
            const max = Number(maxRange.value);
            applyValues(Math.min(min, max), max);
        });
        maxRange.addEventListener('input', () => {
            maxRange.style.zIndex = '3';
            minRange.style.zIndex = '2';
            const min = Number(minRange.value);
            const max = Number(maxRange.value);
            applyValues(min, Math.max(min, max));
        });
        minRange.addEventListener('change', () => applyValues(Number(minRange.value), Number(maxRange.value), { submit: true }));
        maxRange.addEventListener('change', () => applyValues(Number(minRange.value), Number(maxRange.value), { submit: true }));
    });

    document.querySelectorAll('[data-shop-filters] [data-filter-auto-submit]').forEach((input) => {
        input.addEventListener('change', () => {
            submitFilterForm(input.form);
        });
    });

    document.querySelectorAll(
        '[data-shop-filters] .shop-filters__chip, [data-shop-filters] .shop-filters__clear-all, .shop-catalog__mobile-chips .shop-filters__chip, .shop-catalog__mobile-chips .shop-filters__clear-all'
    ).forEach((link) => {
        link.addEventListener('click', () => {
            markScrollToCategoryHeader();
            closeFilterSheet(link.closest('form') || document.querySelector('[data-shop-filters]'));
        });
    });

    mobileMq.addEventListener('change', () => {
        document.querySelectorAll('[data-filter-group]').forEach((group) => {
            delete group.dataset.userToggled;
        });
        applyViewportState();
    });
    applyViewportState();
    scrollToCategoryHeaderIfNeeded();
})();
</script>
