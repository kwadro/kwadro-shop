{% set setting = site_settings() %}
{% set cityData = shop_city_data() %}
{% if show_topbar|default(false) %}
    <div class="shop-topbar">
        <div class="shop-topbar__inner">
            <div class="shop-topbar__links">
                {% for item in setting.menu %}
                    {% if item.megamenutype == 'Link' and item.url %}
                        <a href="{{ path('shop_page', {slug: item.url, _locale: app.request.locale}) }}">{{ item.name }}</a>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="shop-topbar__auth">
                <span>{{ 'shop.welcome'|trans }}</span>
                {% if app.user %}
                    <a href="/">{{ 'shop.my_account'|trans }}</a>
                    <a href="{{ path('app_logout') }}">{{ 'shop.logout'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_login') }}">{{ 'shop.login'|trans }}</a>
                    <a href="{{ path('app_register') }}">{{ 'shop.register'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

<header class="shop-header">
    <div class="shop-header__inner">
        <div class="shop-header__inner-logo">
            <a
                href="{{ absolute_url(path('shop_home')) }}"
                class="site-header__brand"
                title="{{ setting.header.title }}"
            >
                <img
                    src="{{ absolute_url(asset('uploads/images/' ~ setting.header.logo)) }}"
                    alt="{{ setting.header.title }}"
                    class="site-header__logo"
                    width="180"
                    height="72"
                >
            </a>
            {% set cityDetails = cityData.label is not empty and cityData.label != cityData.name ? cityData.label : cityData.subtitle %}
            <button
                type="button"
                id="shop-city-open"
                class="shop-header__city-trigger"
                aria-haspopup="dialog"
                aria-controls="shop-city-modal"
                aria-label="{{ 'shop.header.your_city'|trans }}"
                title="{{ cityDetails|default(cityData.name)|e('html_attr') }}"
            >
                <span class="shop-header__city-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" focusable="false">
                        <path d="M12 2C8.686 2 6 4.686 6 8c0 4.5 6 12 6 12s6-7.5 6-12c0-3.314-2.686-6-6-6zm0 8.25A2.25 2.25 0 1 1 12 5.75a2.25 2.25 0 0 1 0 4.5z"/>
                    </svg>
                </span>
                <span class="shop-header__city-value" id="shop-header-city-value">{{ cityData.name }}</span>
            </button>
        </div>
        <div class="shop-header__actions">
            {% include 'shop/partials/_mini_cart.html.twig' %}

            <div class="shop-header__phone-icon" aria-hidden="true">☎</div>
            <div class="shop-header__phones">
                <strong>
                    {% set phoneLinks = setting.header.phone_links|default([
                        {display: '066-913-30-97', tel: '+380669133097'},
                        {display: '067-343-70-40', tel: '+380673437040'},
                    ]) %}
                    {% for phone in phoneLinks %}
                        {%- if not loop.first %} · {% endif -%}
                        <a href="tel:{{ phone.tel|e('html_attr') }}">{{ phone.display }}</a>
                    {% endfor %}
                </strong>
                <span class="shop-header__work-hours">
                        {{ (setting.header.work_hours|default('shop.work_hours'|trans))|raw }}
                    </span>
            </div>
        </div>
    </div>
</header>

<div id="shop-city-config"
    hidden
    data-save-url="{{ path('shop_city_update', {_locale: app.request.locale}) }}"
    data-search-url="{{ path('shop_city_search', {_locale: app.request.locale}) }}"
    data-csrf-token="{{ csrf_token('city_update') }}"
    data-np-enabled="{{ nova_poshta_enabled() ? '1' : '0' }}"
    data-current-city="{{ cityData|json_encode|e('html_attr') }}"
></div>
