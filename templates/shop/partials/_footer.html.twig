{% set setting = site_settings() %}
{% set facebookUrl = setting.social.facebook_url|default(null) %}
{% set instagramUrl = setting.social.instagram_url|default(null) %}
{% set hasSocial = facebookUrl or instagramUrl %}
<footer class="shop-footer">
    <div class="shop-footer__inner{% if hasSocial %} shop-footer__inner--with-social{% endif %}">

        <div>
            <h4>{{ 'shop.footer.buyers'|trans }}</h4>
            <ul>
                {% for item in setting.menu %}
                    {% if item.megamenutype == 'FooterLink' and item.url %}
                        <li><a href="{{ path('shop_page', {slug: item.url}) }}">{{ item.name }}</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
        <div>
            <h4>{{ 'shop.footer.contacts'|trans }}</h4>
            <ul>
                {% set phoneLinks = setting.header.phone_links|default([
                    {display: '066-913-30-97', tel: '+380669133097'},
                    {display: '067-343-70-40', tel: '+380673437040'},
                ]) %}
                {% for phone in phoneLinks %}
                    <li><a href="tel:{{ phone.tel|e('html_attr') }}">{{ phone.display }}</a></li>
                {% endfor %}
                <li>info@kwadro.com.ua</li>
                <li class="shop-footer__work-hours">{{ (setting.header.work_hours|default('shop.work_hours'|trans))|raw }}</li>
            </ul>
        </div>
        {% if hasSocial %}
            <div class="shop-footer__social">
                <h4>{{ 'shop.footer.social'|trans }}</h4>
                <div class="shop-footer__social-links" role="list">
                    {% if facebookUrl %}
                        <a class="shop-footer__social-link"
                           href="{{ facebookUrl }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="{{ 'shop.footer.facebook'|trans }}"
                           role="listitem">
                            <svg class="shop-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M22 12.07C22 6.48 17.52 2 11.93 2S1.86 6.48 1.86 12.07c0 5.02 3.66 9.18 8.44 9.93v-7.03H7.9v-2.9h2.4V9.84c0-2.37 1.4-3.68 3.56-3.68 1.03 0 2.11.18 2.11.18v2.32h-1.19c-1.17 0-1.54.73-1.54 1.48v1.78h2.62l-.42 2.9h-2.2V22c4.78-.75 8.44-4.91 8.44-9.93z"/>
                            </svg>
                            <span>Facebook</span>
                        </a>
                    {% endif %}
                    {% if instagramUrl %}
                        <a class="shop-footer__social-link"
                           href="{{ instagramUrl }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="{{ 'shop.footer.instagram'|trans }}"
                           role="listitem">
                            <svg class="shop-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zm8.75 1.75a1.125 1.125 0 1 1 0 2.25 1.125 1.125 0 0 1 0-2.25zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z"/>
                            </svg>
                            <span>Instagram</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
    <div class="shop-footer__bottom">
        {{ setting.footer.content|raw }}

    </div>
</footer>
