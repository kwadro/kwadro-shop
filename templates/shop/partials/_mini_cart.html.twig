{% set cart = shop_cart() %}

<div
    class="shop-minicart"
    data-minicart
    data-label-quantity="{{ 'shop.product.quantity'|trans }}"
    data-label-total="{{ 'shop.minicart.total'|trans }}"
    data-label-empty="{{ 'shop.minicart.empty'|trans }}"
    data-label-checkout="{{ 'shop.minicart.checkout'|trans }}"
    data-label-continue="{{ 'shop.minicart.continue_shopping'|trans }}"
    data-label-remove="{{ 'shop.minicart.remove'|trans }}"
    data-label-supplier="{{ 'shop.product.supplier'|trans }}"
    data-label-sku="{{ 'shop.product.sku'|trans }}"
    data-checkout-url="{{ path('shop_checkout', {_locale: app.request.locale}) }}"
    data-home-url="{{ path('shop_home', {_locale: app.request.locale}) }}"
    data-remove-url="{{ path('shop_cart_remove', {_locale: app.request.locale}) }}"
    data-remove-token="{{ csrf_token('cart_remove') }}"
>
    <button
        type="button"
        class="shop-minicart__toggle"
        aria-expanded="false"
        aria-controls="shop-minicart-panel"
        aria-label="{{ 'shop.minicart.open'|trans }}"
    >
        <svg class="shop-minicart__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2zM7.16 14h9.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 21.05 5H5.21L4.27 2H1v2h2l3.6 7.59-1.35 2.44C4.52 15.37 5.48 17 7 17h12v-2H7.42l.74-1z"/>
        </svg>
        <span class="shop-minicart__badge{% if cart.itemCount <= 0 %} shop-minicart__badge--hidden{% endif %}" data-minicart-badge>
            {{ cart.itemCount > 0 ? cart.itemCount : 0 }}
        </span>
    </button>

    <div
        id="shop-minicart-panel"
        class="shop-minicart__panel"
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'shop.minicart.title'|trans }}"
        hidden
    >
        <div class="shop-minicart__header">
            <h2 class="shop-minicart__title">{{ 'shop.minicart.title'|trans }}</h2>
            <button type="button" class="shop-minicart__close" aria-label="{{ 'shop.minicart.close'|trans }}">&times;</button>
        </div>

        <div class="shop-minicart__body" data-minicart-body>
            {% include 'shop/partials/_mini_cart_body.html.twig' with {cart: cart} %}
        </div>
    </div>

    <div class="shop-minicart__backdrop" hidden></div>
</div>
