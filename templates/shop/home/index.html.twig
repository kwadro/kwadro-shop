{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% block title %}{% if product %}{{ product.name }} — {% endif %}{{ setting.seo.meta_title }}{% endblock %}

{% block main %}
    {% if not product %}
        <section class="shop-product-empty">
            <h1 class="shop-product-empty__title">{{ 'shop.product.empty_catalog_title'|trans }}</h1>
            <p class="shop-product-empty__text">{{ 'shop.product.empty_catalog_text'|trans }}</p>
        </section>
    {% else %}
    {% set gallery = product.gallery|default([]) %}
    {% set defaultProductImage = {
        full: asset('uploads/images/' ~ (setting.header.logo|default('favicon.png'))),
        thumb: asset('uploads/images/' ~ (setting.header.logo|default('favicon.png'))),
        alt: product.name,
    } %}
    {% set mainImage = gallery|length > 0 ? gallery[0] : defaultProductImage %}
    <article class="shop-product">
        <div class="shop-product__gallery">
            <div class="shop-product__main-image{% if gallery|length == 0 %} shop-product__main-image--placeholder{% endif %}">
                {% if product.badge %}
                    <span class="shop-product__badge">{{ product.badge }}</span>
                {% endif %}
                <span class="shop-product__discount" id="product-discount-badge"{% if not product.discountPercent %} hidden{% endif %}>
                    {%- if product.discountPercent -%}-{{ product.discountPercent }}%{%- endif -%}
                </span>
                <img
                    id="product-main-image"
                    src="{{ mainImage.full }}"
                    alt="{{ mainImage.alt|default(product.name) }}"
                >
            </div>

            {% if gallery|length > 1 %}
            <div class="shop-product__thumbs" role="list">
                {% for image in gallery %}
                    <button
                        type="button"
                        class="shop-product__thumb{% if loop.first %} is-active{% endif %}"
                        data-full="{{ image.full }}"
                        data-alt="{{ image.alt }}"
                        aria-label="{{ image.alt }}"
                    >
                        <img src="{{ image.thumb }}" alt="{{ image.alt }}">
                    </button>
                {% endfor %}
            </div>
            {% endif %}
        </div>

        <div class="shop-product__info">
            <p class="shop-product__category">{{ product.category }}</p>
            <h1 class="shop-product__title">{{ product.name }}</h1>
            <p class="shop-product__sku">{{ 'shop.product.sku'|trans }}: {{ product.sku }}</p>
            <p class="shop-product__lead">{{ product.shortDescription }}</p>

            <div
                class="shop-product__price-box"
                data-product-offers
                data-offers='{{ product.offers|json_encode|e('html_attr') }}'
                data-you-save-label="{{ 'shop.product.you_save'|trans|e('html_attr') }}"
                data-supplier-label="{{ 'shop.product.supplier'|trans|e('html_attr') }}"
                data-product-in-stock="{{ product.productInStock ? '1' : '0' }}"
            >
                <div class="shop-product__price-row">
                    <div class="shop-product__price{% if not product.hasPrice %} shop-product__price--unavailable{% endif %}">
                        {% if product.hasPrice %}
                            <strong data-offer-price>{{ product.price|number_format(2, ',', ' ') }} ₴</strong>
                            <del data-offer-old-price{% if not product.oldPrice %} hidden{% endif %}>{{ product.oldPrice|number_format(2, ',', ' ') }} ₴</del>
                        {% else %}
                            <strong>{{ 'shop.product.no_price'|trans }}</strong>
                        {% endif %}
                    </div>
                    {% if (product.offers|default([])|length) > 1 %}
                        <button type="button" class="shop-product__offers-btn" data-offers-open>
                            {{ 'shop.product.all_offers'|trans }}
                        </button>
                    {% endif %}
                </div>
                {% if product.hasPrice and product.supplier %}
                    <p class="shop-product__supplier" data-offer-supplier>
                        {{ 'shop.product.supplier'|trans }}:
                        <strong>{{ product.supplier.name }}</strong>
                        {% if product.supplier.phone and (product.offers|default([])|length > 1) %}
                            <span class="shop-product__supplier-meta">{{ product.supplier.phone }}</span>
                        {% endif %}
                    </p>
                {% else %}
                    <p class="shop-product__supplier" data-offer-supplier hidden></p>
                {% endif %}
                <span
                    class="shop-product__save"
                    data-offer-save
                    {% if not product.hasPrice or not product.discountPercent %}hidden{% endif %}
                >
                    {% if product.hasPrice and product.oldPrice %}
                        {{ 'shop.product.you_save'|trans({
                            '%amount%': (product.oldPrice - product.price)|number_format(2, ',', ' ') ~ ' ₴'
                        }) }}
                    {% endif %}
                </span>
            </div>

            <div
                id="product-stock"
                class="shop-product__stock{% if product.inStock %} shop-product__stock--in{% else %} shop-product__stock--out{% endif %}"
                data-in-stock-label="{{ 'shop.product.in_stock'|trans({'%qty%': '__QTY__'})|e('html_attr') }}"
                data-out-of-stock-label="{{ 'shop.product.out_of_stock'|trans|e('html_attr') }}"
            >
                <span class="shop-product__stock-dot"></span>
                <span data-offer-stock-text>
                    {% if product.inStock %}
                        {{ 'shop.product.in_stock'|trans({'%qty%': product.stockQty}) }}
                    {% else %}
                        {{ 'shop.product.out_of_stock'|trans }}
                    {% endif %}
                </span>
            </div>

            <form
                method="post"
                action="{{ path('shop_cart_add', {_locale: app.request.locale}) }}"
                class="shop-product__actions"
                id="product-add-to-cart-form"
                data-add-to-cart
                data-added-label="{{ 'shop.cart.added_short'|trans }}"
                data-default-label="{{ 'shop.add_to_cart'|trans }}"
            >
                <input type="hidden" name="product_id" value="{{ product.id }}">
                {% if product.selectedOfferId %}
                    <input type="hidden" name="offer_id" value="{{ product.selectedOfferId }}" data-offer-id-input>
                {% endif %}
                <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">

                <label class="shop-product__qty">
                    {{ 'shop.product.quantity'|trans }}
                    <input
                        type="number"
                        name="quantity"
                        min="1"
                        max="{{ product.stockQty > 0 ? product.stockQty : 1 }}"
                        value="1"
                        data-offer-qty-input
                        required
                    >
                </label>
                <button type="submit" class="shop-product__buy" id="product-buy-button"{% if not product.inStock or not product.hasPrice %} disabled{% endif %}>
                    {{ 'shop.add_to_cart'|trans }}
                </button>
            </form>

            <ul class="shop-product__features">
                {% for feature in product.features %}
                    <li>{{ feature }}</li>
                {% endfor %}
            </ul>
        </div>
    </article>

    <section class="shop-product__description">
        <h2>{{ 'shop.product.description_title'|trans }}</h2>
        <p>{{ product.description|raw }}</p>
    </section>

    {% if (product.offers|default([])|length) > 1 %}
        {% include 'shop/partials/_product_offers_modal.html.twig' %}
    {% endif %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% if product %}
    <script>
        document.querySelectorAll('.shop-product__thumb').forEach((thumb) => {
            thumb.addEventListener('click', () => {
                const mainImage = document.getElementById('product-main-image');
                mainImage.src = thumb.dataset.full;
                mainImage.alt = thumb.dataset.alt;

                document.querySelectorAll('.shop-product__thumb').forEach((item) => {
                    item.classList.remove('is-active');
                });
                thumb.classList.add('is-active');
            });
        });

        const offersBox = document.querySelector('[data-product-offers]');
        const offersModal = document.getElementById('shop-offers-modal');
        const offerIdInput = document.querySelector('[data-offer-id-input]');

        const formatPrice = (value) => {
            const amount = Number(value);
            if (Number.isNaN(amount)) {
                return '';
            }

            return amount.toLocaleString('uk-UA', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
            }) + ' ₴';
        };

        const applyOffer = (offer) => {
            if (!offer || !offersBox) {
                return;
            }

            const priceEl = offersBox.querySelector('[data-offer-price]');
            const oldPriceEl = offersBox.querySelector('[data-offer-old-price]');
            const supplierEl = offersBox.querySelector('[data-offer-supplier]');
            const saveEl = offersBox.querySelector('[data-offer-save]');
            const discountBadge = document.getElementById('product-discount-badge');
            const supplierLabel = offersBox.dataset.supplierLabel || 'Supplier';
            const youSaveLabel = offersBox.dataset.youSaveLabel || 'You save %amount%';

            if (priceEl) {
                priceEl.textContent = formatPrice(offer.price);
            }

            if (oldPriceEl) {
                if (offer.oldPrice) {
                    oldPriceEl.textContent = formatPrice(offer.oldPrice);
                    oldPriceEl.hidden = false;
                } else {
                    oldPriceEl.hidden = true;
                }
            }

            if (supplierEl && offer.supplier) {
                supplierEl.hidden = false;
                supplierEl.replaceChildren();

                supplierEl.append(`${supplierLabel}: `);

                const nameEl = document.createElement('strong');
                nameEl.textContent = offer.supplier.name;
                supplierEl.append(nameEl);

                if (offer.supplier.phone) {
                    const phoneEl = document.createElement('span');
                    phoneEl.className = 'shop-product__supplier-meta';
                    phoneEl.textContent = offer.supplier.phone;
                    supplierEl.append(phoneEl);
                }
            }

            if (saveEl) {
                if (offer.oldPrice && offer.oldPrice > offer.price) {
                    const saved = formatPrice(offer.oldPrice - offer.price);
                    saveEl.textContent = youSaveLabel.replace('%amount%', saved);
                    saveEl.hidden = false;
                } else {
                    saveEl.hidden = true;
                }
            }

            if (discountBadge) {
                if (offer.discountPercent) {
                    discountBadge.textContent = `-${offer.discountPercent}%`;
                    discountBadge.hidden = false;
                } else {
                    discountBadge.hidden = true;
                }
            }

            if (offerIdInput) {
                offerIdInput.value = String(offer.id);
            }

            const stockBox = document.getElementById('product-stock');
            const stockText = stockBox?.querySelector('[data-offer-stock-text]');
            const qtyInput = document.querySelector('[data-offer-qty-input]');
            const buyButton = document.getElementById('product-buy-button');
            const productInStock = offersBox?.dataset.productInStock === '1';
            const offerQty = Math.max(0, Number(offer.qty) || 0);
            const offerAvailable = productInStock && offerQty > 0;

            if (stockBox && stockText) {
                stockBox.classList.toggle('shop-product__stock--in', offerAvailable);
                stockBox.classList.toggle('shop-product__stock--out', !offerAvailable);
                if (offerAvailable) {
                    stockText.textContent = (stockBox.dataset.inStockLabel || 'In stock (%qty% pcs.)')
                        .replace('__QTY__', String(offerQty));
                } else {
                    stockText.textContent = stockBox.dataset.outOfStockLabel || 'Out of stock';
                }
            }

            if (qtyInput) {
                qtyInput.max = String(Math.max(1, offerQty));
                qtyInput.value = String(Math.min(Number(qtyInput.value) || 1, Math.max(1, offerQty)));
                qtyInput.disabled = !offerAvailable;
            }

            if (buyButton) {
                buyButton.disabled = !offerAvailable;
            }

            offersModal?.querySelectorAll('[data-offer-id]').forEach((button) => {
                const isActive = Number(button.dataset.offerId) === Number(offer.id);
                button.classList.toggle('is-active', isActive);
                button.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });
        };

        const openOffersModal = () => {
            if (!offersModal) {
                return;
            }

            offersModal.hidden = false;
            offersModal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('shop-offers-modal-open');
        };

        const closeOffersModal = () => {
            if (!offersModal) {
                return;
            }

            offersModal.hidden = true;
            offersModal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('shop-offers-modal-open');
        };

        document.querySelector('[data-offers-open]')?.addEventListener('click', openOffersModal);

        offersModal?.querySelectorAll('[data-offers-close]').forEach((element) => {
            element.addEventListener('click', closeOffersModal);
        });

        offersModal?.querySelectorAll('[data-offer-id]').forEach((button) => {
            button.addEventListener('click', () => {
                const offers = JSON.parse(offersBox?.dataset.offers || '[]');
                const offer = offers.find((item) => Number(item.id) === Number(button.dataset.offerId));
                if (!offer) {
                    return;
                }

                applyOffer(offer);
                closeOffersModal();
            });
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && offersModal && !offersModal.hidden) {
                closeOffersModal();
            }
        });

        const addForm = document.querySelector('[data-add-to-cart]');
        if (addForm) {
            addForm.addEventListener('submit', async (event) => {
                event.preventDefault();

                const submitBtn = addForm.querySelector('.shop-product__buy');
                const mainImage = document.getElementById('product-main-image');
                const defaultLabel = addForm.dataset.defaultLabel || submitBtn.textContent;
                const addedLabel = addForm.dataset.addedLabel || defaultLabel;

                submitBtn.disabled = true;

                try {
                    const response = await fetch(addForm.action, {
                        method: 'POST',
                        body: new FormData(addForm),
                        headers: {
                            Accept: 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                    });

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(data.error || 'Request failed');
                    }

                    if (window.ShopCart) {
                        if (data.added_item) {
                            window.ShopCart.trackAddToCart(data.added_item);
                        }

                        window.ShopCart.flyToCart(mainImage);
                        window.ShopCart.update(data.cart, {
                            open: true,
                            highlight: true,
                            scrollToTop: true,
                        });
                    }

                    submitBtn.classList.add('shop-product__buy--added');
                    submitBtn.textContent = addedLabel;

                    window.setTimeout(() => {
                        submitBtn.classList.remove('shop-product__buy--added');
                        submitBtn.textContent = defaultLabel;
                        submitBtn.disabled = false;
                    }, 1800);
                } catch (error) {
                    submitBtn.disabled = false;
                    submitBtn.classList.add('shop-product__buy--error');
                    window.setTimeout(() => submitBtn.classList.remove('shop-product__buy--error'), 1200);
                }
            });
        }
    </script>
    {% endif %}
{% endblock %}
