{% extends 'shop/layout.html.twig' %}
{% set setting = site_settings() %}
{% set pageTitle = supplier.metaTitle ?: (setting.seo.title|default(setting.seo.meta_title)) %}
{% set pageMetaTitle = supplier.metaTitle ?: setting.seo.meta_title %}
{% set pageMetaDescription = supplier.metaDescription ?: setting.seo.meta_description %}
{% set pageOgTitle = supplier.ogTitle ?: setting.seo.og_title %}
{% set pageOgDescription = supplier.ogDescription ?: setting.seo.og_description %}
{% set pageOgType = supplier.ogType ?: setting.seo.og_type %}
{% set pageOgImageFile = supplier.ogImage ?: setting.seo.og_image %}
{% set pageOgImage = pageOgImageFile ? absolute_url(asset('uploads/images/' ~ pageOgImageFile)) : '' %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block meta_title %}{{ pageMetaTitle }}{% endblock %}
{% block meta_description %}{{ pageMetaDescription }}{% endblock %}
{% block og_title %}{{ pageOgTitle }}{% endblock %}
{% block og_description %}{{ pageOgDescription }}{% endblock %}
{% block og_type %}{{ pageOgType }}{% endblock %}
{% block og_image %}{{ pageOgImage }}{% endblock %}
{% block og_url %}{{ absolute_url(path('shop_supplier', {_locale: app.request.locale, slug: supplier.slug})) }}{% endblock %}
{% block canonical_url %}{{ absolute_url(path('shop_supplier', {_locale: app.request.locale, slug: supplier.slug})) }}{% endblock %}

{% block main %}
    <article class="shop-page shop-category-page shop-supplier-page">
        <nav class="shop-category-page__breadcrumb" aria-label="breadcrumb">
            <a href="{{ path('shop_home', {_locale: app.request.locale}) }}">{{ 'shop.category.home'|trans }}</a>
            <span aria-hidden="true">/</span>
            <span>{{ supplier.name }}</span>
        </nav>

        <header class="shop-category-page__header">
            <h1 class="shop-page__title">{{ supplier.name }}</h1>
            {% if supplier.description %}
                <div class="shop-supplier-page__description">{{ supplier.description|raw }}</div>
            {% endif %}
        </header>

        {% if products is empty %}
            <div class="shop-category-page__empty">
                <p>{{ 'shop.supplier.empty_products'|trans }}</p>
            </div>
        {% else %}
            <div class="shop-catalog-grid">
                {% for product in products %}
                    {% set gallery = product.gallery|default([]) %}
                    {% set image = gallery|length > 0 ? gallery[0] : {
                        full: asset('uploads/images/' ~ (setting.header.logo|default('favicon.png'))),
                        alt: product.name
                    } %}
                    <article class="shop-product-card">
                        <a class="shop-product-card__media" href="{{ path('shop_product', {_locale: app.request.locale, slug: product.slug}) }}">
                            <img src="{{ image.full }}" alt="{{ image.alt|default(product.name) }}">
                            {% if product.badge %}
                                <span class="shop-product-card__badge">{{ product.badge }}</span>
                            {% endif %}
                        </a>
                        <div class="shop-product-card__body">
                            <h2 class="shop-product-card__title">
                                <a href="{{ path('shop_product', {_locale: app.request.locale, slug: product.slug}) }}">{{ product.name }}</a>
                            </h2>
                            <p class="shop-product-card__sku">{{ 'shop.product.sku'|trans }}: {{ product.sku }}</p>
                            <div class="shop-product-card__price">
                                {% if product.hasPrice %}
                                    <strong>{{ product.price|number_format(2, ',', ' ') }} ₴</strong>
                                    {% if product.oldPrice %}
                                        <del>{{ product.oldPrice|number_format(2, ',', ' ') }} ₴</del>
                                    {% endif %}
                                {% else %}
                                    <strong>{{ 'shop.product.no_price'|trans }}</strong>
                                {% endif %}
                            </div>
                            <p class="shop-product-card__stock{% if product.inStock %} shop-product-card__stock--in{% else %} shop-product-card__stock--out{% endif %}">
                                {% if product.inStock %}
                                    {{ 'shop.product.in_stock'|trans({'%qty%': product.stockQty}) }}
                                {% else %}
                                    {{ 'shop.product.out_of_stock'|trans }}
                                {% endif %}
                            </p>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </article>
{% endblock %}
