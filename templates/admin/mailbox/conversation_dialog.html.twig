<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'admin.mailbox_conversation.dialog'|trans }}</title>
    <style>
        body {
            margin: 0;
            background: #f6f7f9;
            color: #202124;
            font-family: system-ui, sans-serif;
        }
        .thread {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 16px;
        }
        .bubble {
            max-width: min(78%, 760px);
            padding: 10px 12px;
            border-radius: 12px;
            background: #fff;
            border: 1px solid #e6e6e6;
        }
        .bubble--out {
            margin-left: auto;
            background: #e8f0fe;
            border-color: #d2e3fc;
        }
        .bubble__meta {
            margin-bottom: 4px;
            font-size: 12px;
            color: #5f6368;
        }
        .bubble__subject {
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 600;
        }
        .bubble__body {
            font-size: 14px;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }
        .bubble__body img {
            max-width: 100%;
            height: auto;
        }
        .bubble__body p:first-child {
            margin-top: 0;
        }
        .bubble__body p:last-child {
            margin-bottom: 0;
        }
    </style>
</head>
<body>
    <div class="thread">
        {% for message in messages %}
            <article class="bubble {{ message.outgoing ? 'bubble--out' : 'bubble--in' }}">
                <div class="bubble__meta">
                    <strong>{{ message.direction }}</strong>
                    · {{ message.receivedAt|date('Y-m-d H:i') }}
                    · {{ message.who }}
                </div>
                {% if message.subject %}
                    <div class="bubble__subject">{{ message.subject }}</div>
                {% endif %}
                <div class="bubble__body">
                    {% if message.bodyHtml %}
                        {{ message.bodyHtml|raw }}
                    {% else %}
                        <span style="color:#5f6368">—</span>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
</body>
</html>
