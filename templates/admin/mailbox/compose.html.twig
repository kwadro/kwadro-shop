{% extends '@EasyAdmin/page/content.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('lib/admin-mailbox-compose.css') }}">
{% endblock %}

{% block body_javascript %}
    {{ parent() }}
    <script src="{{ asset('lib/admin-mailbox-compose.js') }}" defer></script>
{% endblock %}

{% block content_title %}{{ 'admin.mailbox_compose.title'|trans }}{% endblock %}

{% block main %}
<div class="gmail-compose">
    <div class="gmail-compose__window">
        <div class="gmail-compose__header">
            <div class="gmail-compose__title">{{ 'admin.mailbox_compose.title'|trans }}</div>
            <a class="gmail-compose__close" href="{{ inbox_url }}" title="{{ 'admin.mailbox_compose.close'|trans }}">&times;</a>
        </div>

        {% if error %}
            <div class="gmail-compose__error">{{ error }}</div>
        {% endif %}

        <form method="post" class="gmail-compose__form" id="gmail-compose-form" novalidate>
            <div class="gmail-compose__row gmail-compose__row--from">
                <label for="mailbox_id">{{ 'admin.mailbox_compose.from'|trans }}</label>
                <select name="mailbox_id" id="mailbox_id" required>
                    {% for account in accounts %}
                        <option value="{{ account.id }}" {% if form.mailbox_id == account.id %}selected{% endif %}>
                            {{ account.name }} &lt;{{ account.email }}&gt;
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="gmail-compose__row">
                <label for="compose-to">{{ 'admin.mailbox_compose.to'|trans }}</label>
                <input type="text" name="to" id="compose-to" value="{{ form.to }}" placeholder="name@example.com" required autocomplete="off">
                <button type="button" class="gmail-compose__chip-toggle" id="toggle-cc-bcc" aria-expanded="false">
                    {{ 'admin.mailbox_compose.cc_bcc'|trans }}
                </button>
            </div>

            <div class="gmail-compose__row gmail-compose__row--extra" id="compose-cc-row" hidden>
                <label for="compose-cc">{{ 'admin.mailbox_compose.cc'|trans }}</label>
                <input type="text" name="cc" id="compose-cc" value="{{ form.cc }}" autocomplete="off">
            </div>

            <div class="gmail-compose__row gmail-compose__row--extra" id="compose-bcc-row" hidden>
                <label for="compose-bcc">{{ 'admin.mailbox_compose.bcc'|trans }}</label>
                <input type="text" name="bcc" id="compose-bcc" value="{{ form.bcc }}" autocomplete="off">
            </div>

            <div class="gmail-compose__row">
                <label for="compose-subject">{{ 'admin.mailbox_compose.subject'|trans }}</label>
                <input type="text" name="subject" id="compose-subject" value="{{ form.subject }}" required autocomplete="off">
            </div>

            <div class="gmail-compose__body-wrap">
                <textarea name="body" id="compose-body" class="gmail-compose__body" rows="14" placeholder="{{ 'admin.mailbox_compose.body_placeholder'|trans }}">{{ form.body }}</textarea>
            </div>

            <div class="gmail-compose__footer">
                <button type="submit" class="gmail-compose__send">
                    {{ 'admin.mailbox_compose.send'|trans }}
                </button>
                <a class="gmail-compose__discard" href="{{ inbox_url }}">{{ 'admin.mailbox_compose.discard'|trans }}</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
