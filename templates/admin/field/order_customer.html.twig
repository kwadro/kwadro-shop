{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% set order = entity.instance %}
{% set customer = order.customer %}

<dl class="row mb-0 order-customer-block">
    {% if customer %}
        <dt class="col-sm-3 col-lg-2">{{ 'admin.order.customer_account'|trans }}</dt>
        <dd class="col-sm-9 col-lg-4">
            <a href="{{ ea_url()
                .setController('App\\Controller\\Admin\\UserCrudController')
                .setAction('detail')
                .setEntityId(customer.id) }}">
                {{ customer.fullName|default(customer.email)|default('—') }}
            </a>
        </dd>
    {% else %}
        <dt class="col-sm-3 col-lg-2">{{ 'admin.order.customer_account'|trans }}</dt>
        <dd class="col-sm-9 col-lg-4">
            {{ 'admin.order.guest_customer'|trans({'%visitor_id%': order.visitorId|default('—')}) }}
        </dd>
    {% endif %}

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.customer_name'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.customerName|default('—') }}</dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.customer_phone'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.customerPhone|default('—') }}</dd>

    {% if not customer %}
        <dt class="col-sm-3 col-lg-2">{{ 'admin.order.customer_email'|trans }}</dt>
        <dd class="col-sm-9 col-lg-4">{{ order.customerEmail|default('—') }}</dd>
    {% endif %}

    {% if order.doNotCall %}
        <dt class="col-sm-3 col-lg-2">{{ 'admin.order.do_not_call'|trans }}</dt>
        <dd class="col-sm-9 col-lg-4">{{ 'admin.order.do_not_call_yes'|trans }}</dd>
    {% endif %}
</dl>
