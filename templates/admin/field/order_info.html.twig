{# @var entity \EasyCorp\Bundle\EasyAdminBundle\Dto\EntityDto #}
{% set order = entity.instance %}
{% set statusClass = order.status.value == 'paid' ? 'success' : (order.status.value == 'in_process' ? 'warning' : (order.status.value == 'awaiting_deposit_for_shipment' ? 'info' : 'secondary')) %}

<dl class="row mb-0 order-info-block">
    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.order_number'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.orderNumber|default('—') }}</dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.status_label'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">
        <span class="badge text-bg-{{ statusClass }}">
            {{ ('admin.order.status.' ~ order.status.value)|trans }}
        </span>
    </dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.created_at'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.createdAt ? order.createdAt|date('d.m.Y H:i') : '—' }}</dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.updated_at'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.updatedAt ? order.updatedAt|date('d.m.Y H:i') : '—' }}</dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.currency'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.currency|default('—') }}</dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.locale'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">{{ order.locale|default('—') }}</dd>

    <dt class="col-sm-3 col-lg-2">{{ 'admin.order.site'|trans }}</dt>
    <dd class="col-sm-9 col-lg-4">
        {% if order.site %}
            {{ order.site.code|default('—') }} · {{ order.site.domain|default('—') }}
        {% else %}
            —
        {% endif %}
    </dd>
</dl>
