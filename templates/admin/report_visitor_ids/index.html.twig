{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block main %}
    <div class="card shadow-sm" data-report-visitor-ids data-table-url="{{ table_url }}">
        <div class="card-body">
            <ul class="nav nav-tabs mb-3" role="tablist" data-report-periods>
                {% for period in periods %}
                    <li class="nav-item" role="presentation">
                        <button
                            type="button"
                            class="nav-link{% if period == days %} active{% endif %}"
                            role="tab"
                            data-days="{{ period }}"
                            aria-selected="{{ period == days ? 'true' : 'false' }}"
                        >
                            {{ ('admin.report_visitor_ids.period_' ~ period)|trans }}
                        </button>
                    </li>
                {% endfor %}
            </ul>

            <div data-report-content>
                {% include 'admin/report_visitor_ids/_table.html.twig' %}
            </div>
        </div>
    </div>

    <script>
        (function () {
            const root = document.querySelector('[data-report-visitor-ids]');
            if (!root) {
                return;
            }

            const tableUrl = root.getAttribute('data-table-url');
            const content = root.querySelector('[data-report-content]');
            const tabs = root.querySelectorAll('[data-report-periods] [data-days]');
            let activeRequest = null;

            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    const days = tab.getAttribute('data-days');
                    if (!days || tab.classList.contains('active') || tab.disabled) {
                        return;
                    }

                    tabs.forEach(function (item) {
                        item.classList.toggle('active', item === tab);
                        item.setAttribute('aria-selected', item === tab ? 'true' : 'false');
                        item.disabled = true;
                    });

                    content.style.opacity = '0.5';

                    if (activeRequest) {
                        activeRequest.abort();
                    }

                    const controller = new AbortController();
                    activeRequest = controller;

                    const url = new URL(tableUrl, window.location.origin);
                    url.searchParams.set('days', days);

                    fetch(url.toString(), {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'text/html',
                        },
                        credentials: 'same-origin',
                        signal: controller.signal,
                    })
                        .then(function (response) {
                            if (!response.ok) {
                                throw new Error('Request failed');
                            }
                            return response.text();
                        })
                        .then(function (html) {
                            content.innerHTML = html;
                            const params = new URLSearchParams(window.location.search);
                            params.set('days', days);
                            const next = window.location.pathname + '?' + params.toString();
                            window.history.replaceState({}, '', next);
                        })
                        .catch(function (error) {
                            if (error.name === 'AbortError') {
                                return;
                            }
                            content.innerHTML = '<p class="text-danger mb-0">{{ 'admin.report_visitor_ids.load_error'|trans|e('js') }}</p>';
                        })
                        .finally(function () {
                            tabs.forEach(function (item) {
                                item.disabled = false;
                            });
                            content.style.opacity = '1';
                            if (activeRequest === controller) {
                                activeRequest = null;
                            }
                        });
                });
            });
        })();
    </script>
{% endblock %}
