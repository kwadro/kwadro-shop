{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ page_title }}{% endblock %}

{% block main %}
    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-muted mb-3">
                {{ 'admin.report_visitor_ids.intro'|trans({'%days%': days}) }}
            </p>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'admin.report_visitor_ids.day'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'admin.report_visitor_ids.requests'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'admin.report_visitor_ids.google_bot'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'admin.report_visitor_ids.unique_ips'|trans }}</th>
                            <th scope="col" class="text-end">{{ 'admin.report_visitor_ids.new_ips'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>{{ row.date }}</td>
                                <td class="text-end">{{ row.requests }}</td>
                                <td class="text-end">{{ row.googleBotRequests }}</td>
                                <td class="text-end">{{ row.uniqueIps }}</td>
                                <td class="text-end">{{ row.newIps }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted">{{ 'admin.report_visitor_ids.empty'|trans }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="table-secondary fw-semibold">
                            <td>{{ 'admin.report_visitor_ids.total_7_days'|trans({'%days%': days}) }}</td>
                            <td class="text-end">{{ totals.requests }}</td>
                            <td class="text-end">{{ totals.googleBotRequests }}</td>
                            <td class="text-end">{{ totals.uniqueIps }}</td>
                            <td class="text-end">{{ totals.newIps }}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
