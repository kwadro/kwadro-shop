{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ 'admin.blog_article.facebook_draft'|trans }}{% endblock %}

{% block main %}
    <div class="content-panel" style="max-width: 720px;">
        <div class="content-panel-header">
            <h2 style="margin:0;">{{ article.title }}</h2>
            <p style="margin:.5rem 0 0;color:#666;">
                {{ 'admin.blog_article.facebook_draft_help'|trans }}
            </p>
        </div>
        <div class="content-panel-body">
            <label for="fb-draft" class="form-label">{{ 'admin.blog_article.facebook_draft_text'|trans }}</label>
            <textarea id="fb-draft" class="form-control" rows="14" readonly style="font-family: ui-monospace, monospace; white-space: pre-wrap;">{{ draft }}</textarea>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" id="fb-copy-btn">
                    {{ 'admin.blog_article.facebook_copy'|trans }}
                </button>
                <a class="btn btn-secondary" href="{{ regenerateUrl }}">
                    {{ 'admin.blog_article.facebook_regenerate'|trans }}
                </a>
                <a class="btn btn-secondary" href="{{ editUrl }}">
                    {{ 'admin.blog_article.facebook_edit'|trans }}
                </a>
                <a class="btn btn-outline-secondary" href="{{ articleUrl }}" target="_blank" rel="noopener">
                    {{ 'admin.blog_article.facebook_open_article'|trans }}
                </a>
                <a class="btn btn-link" href="javascript:history.back()">
                    {{ 'admin.blog_article.facebook_back'|trans }}
                </a>
            </div>

            <p id="fb-copy-status" class="mt-2 text-success" hidden>
                {{ 'admin.blog_article.facebook_copied'|trans }}
            </p>
        </div>
    </div>

    <script>
        (function () {
            const btn = document.getElementById('fb-copy-btn');
            const area = document.getElementById('fb-draft');
            const status = document.getElementById('fb-copy-status');
            if (!btn || !area) return;

            btn.addEventListener('click', async function () {
                area.select();
                try {
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        await navigator.clipboard.writeText(area.value);
                    } else {
                        document.execCommand('copy');
                    }
                    if (status) {
                        status.hidden = false;
                        setTimeout(function () { status.hidden = true; }, 2000);
                    }
                } catch (e) {
                    area.focus();
                }
            });
        })();
    </script>
{% endblock %}
