{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
    {% set filtered = statsScopedToFilters|default(false) %}
    {% set defaultToday = statsDefaultToday|default(true) %}
    <div class="alert alert-info d-flex flex-wrap gap-4 align-items-center mb-3" role="status">
        <div>
            <strong>
                {% if filtered %}
                    {{ 'admin.request_list.unique_ips_filtered'|trans }}
                {% elseif defaultToday %}
                    {{ 'admin.request_list.unique_ips_today'|trans }}
                {% else %}
                    {{ 'admin.request_list.unique_ips_filtered'|trans }}
                {% endif %}
                :
            </strong>
            <span class="fs-4 ms-1">{{ uniqueIpsToday|default(0) }}</span>
        </div>
        <div class="text-muted">
            {% if filtered %}
                {{ 'admin.request_list.requests_filtered'|trans }}
            {% elseif defaultToday %}
                {{ 'admin.request_list.requests_today'|trans }}
            {% else %}
                {{ 'admin.request_list.requests_filtered'|trans }}
            {% endif %}
            :
            <strong>{{ requestsToday|default(0) }}</strong>
        </div>
    </div>

    {{ parent() }}
{% endblock %}
